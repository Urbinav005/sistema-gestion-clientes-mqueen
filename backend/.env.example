# Ejemplo de backend/.env: cópialo a .env y pon tus datos reales. Este archivo sí se sube a git.
# DB_PASSWORD y DB_NOMBRE van entre comillas dobles para que los espacios y el # no se corten.
DB_USUARIO=postgres
DB_PASSWORD="cambia_esta_contrasena"
DB_HOST=localhost
DB_PUERTO=5432
DB_NOMBRE="Boceto de BD para Mqueen"

# Clave con la que se firman los tokens de sesión (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO="pon_aqui_tu_clave"
# Minutos que dura una sesión (480 = 8 horas)
JWT_MINUTOS=480
