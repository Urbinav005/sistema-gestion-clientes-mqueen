digraph G {
  graph [fontname="DejaVu Sans", nodesep=0.35, ranksep=0.32, splines=ortho, bgcolor=white, dpi=170];
  node  [fontname="DejaVu Sans", fontsize=10, color=black, penwidth=1.2, margin="0.12,0.05"];
  edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7, penwidth=1.0];
  ini [shape=oval, label="Inicio"];
  in [shape=parallelogram, label="Leer idOrden,\npartidas (clave, cantidad)"];
  ord [shape=diamond, label="¿existeOrden\n(idOrden)?", margin="0.02,0.02"];
  e0 [shape=parallelogram, label="Mostrar \"La orden\nno existe\""];
  pn [shape=box, label="n ← longitud(partidas)"];
  vac [shape=diamond, label="¿n = 0?", margin="0.02,0.02"];
  e1 [shape=parallelogram, label="Mostrar \"Agrega al menos\nuna refacción\""];
  agr [shape=box, label="partidas ← agruparPorClave(partidas)\nn ← longitud(partidas)\ni ← 1"];
  w1 [shape=diamond, label="¿i <= n?", margin="0.02,0.02"];
  disp [shape=box, label="disponible ←\nstockActual(partidas[i].clave)"];
  cant [shape=diamond, label="¿cantidad <= 0?", margin="0.02,0.02"];
  e2 [shape=parallelogram, label="Mostrar \"Cantidad\nno válida\""];
  ex [shape=diamond, label="¿cantidad >\ndisponible?", margin="0.02,0.02"];
  e3 [shape=parallelogram, label="Mostrar \"No hay existencia\nsuficiente de \" + clave"];
  inc [shape=box, label="i ← i + 1"];
  tx [shape=box, label="iniciarTransaccion()\ni ← 1"];
  w2 [shape=diamond, label="¿i <= n?", margin="0.02,0.02"];
  desc [shape=box, label="nuevoStock ← stockActual(clave) − cantidad\nactualizarStock(clave, nuevoStock)\nregistrarSalida(idOrden, clave, cantidad)"];
  al [shape=diamond, label="¿nuevoStock <=\nstockMinimo(clave)?", margin="0.02,0.02"];
  ma [shape=box, label="marcarAlerta(clave)"];
  inc2 [shape=box, label="i ← i + 1"];
  conf [shape=box, label="confirmarTransaccion()"];
  ok [shape=parallelogram, label="Mostrar \"Salida\nregistrada\""];
  fin [shape=oval, label="Fin"];
  ini -> in [];
  in -> ord [];
  ord -> e0 [xlabel="No", ];
  ord -> pn [xlabel="Sí", ];
  pn -> vac [];
  vac -> e1 [xlabel="Sí", ];
  vac -> agr [xlabel="No", ];
  agr -> w1 [];
  w1 -> disp [xlabel="Sí", ];
  disp -> cant [];
  cant -> e2 [xlabel="Sí", ];
  cant -> ex [xlabel="No", ];
  ex -> e3 [xlabel="Sí", ];
  ex -> inc [xlabel="No", ];
  inc -> w1 [constraint=false];
  w1 -> tx [xlabel="No", ];
  tx -> w2 [];
  w2 -> desc [xlabel="Sí", ];
  desc -> al [];
  al -> ma [xlabel="Sí", ];
  al -> inc2 [xlabel="No", ];
  ma -> inc2 [];
  inc2 -> w2 [constraint=false];
  w2 -> conf [xlabel="No", ];
  conf -> ok [];
  ok -> fin [];
  e0 -> fin [];
  e1 -> fin [];
  e2 -> fin [];
  e3 -> fin [];
}
