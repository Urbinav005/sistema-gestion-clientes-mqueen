digraph G {
  graph [fontname="DejaVu Sans", nodesep=0.35, ranksep=0.32, splines=ortho, bgcolor=white, dpi=170];
  node  [fontname="DejaVu Sans", fontsize=10, color=black, penwidth=1.2, margin="0.12,0.05"];
  edge  [fontname="DejaVu Sans", fontsize=9, arrowsize=0.7, penwidth=1.0];
  ini [shape=oval, label="Inicio"];
  in [shape=parallelogram, label="Leer clave, nombre, stock,\nprecio, stockMinimo"];
  p1 [shape=box, label="errores ← 0\ni ← 1"];
  w [shape=diamond, label="¿i <= 5?", margin="0.02,0.02"];
  vac [shape=diamond, label="¿campo[i]\nvacío?", margin="0.02,0.02"];
  e1 [shape=parallelogram, label="Mostrar \"Falta el\ncampo \" + campo[i]"];
  p2 [shape=box, label="errores ← errores + 1"];
  p3 [shape=box, label="i ← i + 1"];
  err [shape=diamond, label="¿errores > 0?", margin="0.02,0.02"];
  val [shape=diamond, label="¿stock < 0 o\nstockMinimo < 0\no precio <= 0?", margin="0.02,0.02"];
  e2 [shape=parallelogram, label="Mostrar \"Cantidades o\nprecio no válidos\""];
  dup [shape=diamond, label="¿existeClave\n(clave)?", margin="0.02,0.02"];
  e3 [shape=parallelogram, label="Mostrar \"La clave\nya existe\""];
  g [shape=box, label="guardarRefaccion(clave, nombre,\nstock, precio, stockMinimo)"];
  al [shape=diamond, label="¿stock <=\nstockMinimo?", margin="0.02,0.02"];
  ma [shape=box, label="marcarAlerta(clave)"];
  ok [shape=parallelogram, label="Mostrar \"Refacción\nregistrada\""];
  fin [shape=oval, label="Fin"];
  ini -> in [];
  in -> p1 [];
  p1 -> w [];
  w -> vac [xlabel="Sí", ];
  vac -> e1 [xlabel="Sí", ];
  e1 -> p2 [];
  p2 -> p3 [];
  vac -> p3 [xlabel="No", ];
  p3 -> w [constraint=false];
  w -> err [xlabel="No", ];
  err -> fin [xlabel="Sí", constraint=false];
  err -> val [xlabel="No", ];
  val -> e2 [xlabel="Sí", ];
  val -> dup [xlabel="No", ];
  dup -> e3 [xlabel="Sí", ];
  dup -> g [xlabel="No", ];
  g -> al [];
  al -> ma [xlabel="Sí", ];
  al -> ok [xlabel="No", ];
  ma -> ok [];
  ok -> fin [];
  e2 -> fin [];
  e3 -> fin [];
}
